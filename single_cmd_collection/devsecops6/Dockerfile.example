# Beginnt mit einem vorhandenen Python-Image.
FROM python:3.12-slim

# Setzt das Arbeitsverzeichnis im Container
WORKDIR /app

# Kopiert die Abhängigkeitsliste und installiert die Abhängigkeiten
COPY requirements.txt .
RUN pip install -r requirements.txt

# Kopiert den restlichen Anwendungscode
COPY . .

# Legt fest, was beim Start des Containers ausgeführt wird
CMD ["python", "app.py"]
